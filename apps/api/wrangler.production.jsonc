{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "getfreeseeds-api",
  "account_id": "cb5066a6d71ecdee0bd7ed8aacb4d3c2",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-27",
  "workers_dev": true,
  "d1_databases": [{ "binding": "DB", "database_name": "getfreeseeds-prod", "database_id": "02b707df-a10c-4645-9516-a2a4541f6fab" }],
  "r2_buckets": [{ "binding": "RECEIPTS", "bucket_name": "getfreeseeds-receipts-prod" }],
  "queues": {
    "producers": [{ "binding": "EVENTS", "queue": "getfreeseeds-events-prod" }],
    "consumers": [{ "queue": "getfreeseeds-events-prod", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 5, "dead_letter_queue": "getfreeseeds-events-prod-dlq" }]
  },
  "vars": { "DEPLOYMENT_STATE": "WHATSAPP_OTP_REQUIRED", "WHATSAPP_PROVIDER": "meta", "META_PROVIDER_ENABLED": "false", "META_CAPI_ENABLED": "false", "META_INSTANT_FORM_ENABLED": "false", "META_PAGE_ID": "101192938541236", "META_INSTANT_FORM_ID": "1093015800183328" }
}
