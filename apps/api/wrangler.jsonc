{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "getfreeseeds-api-staging",
  "account_id": "cb5066a6d71ecdee0bd7ed8aacb4d3c2",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-27",
  "workers_dev": true,
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [{ "binding": "DB", "database_name": "getfreeseeds-staging", "database_id": "17b7e9f6-e08b-4bff-a756-10de30b49ab1", "migrations_dir": "../../migrations" }],
  "r2_buckets": [{ "binding": "RECEIPTS", "bucket_name": "getfreeseeds-receipts-staging" }],
  "queues": {
    "producers": [{ "binding": "EVENTS", "queue": "getfreeseeds-events-staging" }],
    "consumers": [{ "queue": "getfreeseeds-events-staging", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 5, "dead_letter_queue": "getfreeseeds-events-staging-dlq" }]
  },
  // FLOW_PRIVATE_KEY and META_ACCESS_TOKEN are Wrangler secret bindings, never vars values.
  "vars": { "DEPLOYMENT_STATE": "PRODUCTION_INTEGRATION_READY", "WHATSAPP_PROVIDER": "meta", "META_PROVIDER_ENABLED": "true", "WHATSAPP_CHECKOUT_MODE": "guided", "COD_V1_ENABLED": "true", "COD_ROLLOUT_MODE": "PUBLIC", "PAYMENT_AUTOMATION_V2_ENABLED": "true", "PAYMENT_REMINDERS_V2_ENABLED": "true", "PAYMENT_UTILITY_TEMPLATES_APPROVED": "false", "META_PHONE_NUMBER_ID": "1323932417479627", "META_WABA_ID": "2616648355452496", "META_FLOW_ID": "28410343535328014", "META_CAPI_ENABLED": "false", "META_INSTANT_FORM_ENABLED": "false", "META_PAGE_ID": "101192938541236", "META_INSTANT_FORM_ID": "1093015800183328" }
}
